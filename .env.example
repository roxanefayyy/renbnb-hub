# Login password for the hub (only you)
HUB_PASSWORD=change-me
# Any long random string (used to sign your login cookie)
SESSION_SECRET=replace-with-a-long-random-string
# Postgres connection string (Neon via Vercel Storage). Leave empty locally to use the built-in local database.
DATABASE_URL=
# Hospitable personal access token (Hospitable > Settings > API access)
HOSPITABLE_TOKEN=
# Secret for the automatic daily sync (Vercel Cron)
CRON_SECRET=replace-with-another-random-string
